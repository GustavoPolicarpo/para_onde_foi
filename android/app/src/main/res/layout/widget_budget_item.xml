<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="42dp"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="2dp"
    android:paddingVertical="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_budget_category"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#26332B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_budget_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#53635A"
            android:textSize="10sp"
            android:maxLines="1" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_budget_row_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="3dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#176B58"
        android:progressBackgroundTint="#D9E5DD" />
</LinearLayout>
