<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_quick_entry_background">

    <TextView
        android:id="@+id/widget_month_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GASTOS DO MÊS"
        android:textColor="#53635A"
        android:textSize="11sp"
        android:letterSpacing="0.08"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_total"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="R$ 0,00"
        android:textColor="#145C48"
        android:textSize="27sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_budget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Configure limites para acompanhar os orçamentos"
        android:textColor="#53635A"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <ProgressBar
        android:id="@+id/widget_budget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#176B58"
        android:progressBackgroundTint="#D9E5DD" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="9dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_expense_button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_expense_button_background"
            android:gravity="center"
            android:text="+ Despesa"
            android:textColor="#A53D35"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
