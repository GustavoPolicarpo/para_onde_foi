<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="4dp"
    android:background="@drawable/widget_quick_entry_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_month_previous"
            android:layout_width="26dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="‹"
            android:textColor="#53635A"
            android:textSize="24sp"
            android:contentDescription="Mês anterior" />
        <TextView
            android:id="@+id/widget_month_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="7dp"
            android:text="OUT/26"
            android:textColor="#53635A"
            android:textSize="10sp"
            android:letterSpacing="0.02"
            android:textStyle="bold"
            android:maxLines="1" />
        <TextView
            android:id="@+id/widget_total"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="R$ 0,00"
            android:textColor="#145C48"
            android:textSize="19sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_month_next"
            android:layout_width="26dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="›"
            android:textColor="#53635A"
            android:textSize="24sp"
            android:contentDescription="Próximo mês" />
        <TextView
            android:id="@+id/widget_expense_button"
            android:layout_width="34dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_expense_button_background"
            android:gravity="center"
            android:text="+"
            android:textColor="#A53D35"
            android:textSize="23sp"
            android:textStyle="bold"
            android:contentDescription="Adicionar despesa" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_budget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:text="Nenhuma categoria cadastrada"
        android:textColor="#53635A"
        android:textSize="11sp" />

    <ListView
        android:id="@+id/widget_budgets"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#E3E8E4"
        android:dividerHeight="1dp"
        android:fadeScrollbars="false"
        android:scrollbarStyle="insideInset"
        android:scrollbars="vertical" />
</LinearLayout>
